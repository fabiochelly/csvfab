// Resources of csvfab.exe: the icon (taskbar, Start menu, "Open with") and the
// version block that Windows and winget read. version.h is written by the release
// workflow (VER_COMMA 1,2,3,0 and VER_STR "1.2.3").
#include <winver.h>
#include "version.h"

1 ICON "../../icons/csvfab.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_COMMA
PRODUCTVERSION VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fabio Chelly"
            VALUE "FileDescription", "csvfab"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "csvfab"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "csvfab.exe"
            VALUE "ProductName", "csvfab"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
