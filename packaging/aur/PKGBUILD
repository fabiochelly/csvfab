# Maintainer: Fabio Chelly
pkgname=csvfab
pkgver=2.1.2
pkgrel=1
pkgdesc="Desktop CSV editor: open, filter, clean and rewrite large CSV files in place"
arch=('x86_64' 'aarch64')
url="https://github.com/fabiochelly/csvfab"
license=('MIT')
# The window toolkit loads xkbcommon, EGL / OpenGL and Wayland or X11 at run time.
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme')
optdepends=('wayland: Wayland sessions'
            'libxcursor: X11 sessions'
            'libxrandr: X11 sessions'
            'libxi: X11 sessions'
            'xdg-desktop-portal: the Open and Save dialogs'
            'curl: installing a font from the font menu')
makedepends=('cargo')
options=('!lto')   # the workspace's release profile does its own
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('82d20c176bb047fc24962832d8c29d8ff897d60a03b59e5a068530845f3528da')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release -p csvfab
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/csvfab "$pkgdir/usr/bin/csvfab"
    install -Dm644 icons/csvfab.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/csvfab.svg"
    for s in 16 24 32 48 64 128 256 512; do
        install -Dm644 "icons/csvfab-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/csvfab.png"
    done
    install -Dm644 csvfab.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
