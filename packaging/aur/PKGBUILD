# Maintainer: Fabio Chelly
pkgname=csvfab
pkgver=1.20.0
pkgrel=1
pkgdesc="Desktop CSV editor: open, filter, clean and rewrite large CSV files in place"
arch=('any')
url="https://github.com/fabiochelly/csvfab"
license=('MIT')
depends=('python')
optdepends=('chromium: the app window (any Chromium-based browser works)'
            'google-chrome: the app window'
            'brave-bin: the app window'
            'microsoft-edge-stable-bin: the app window')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6e5a805319f8c7dfddceda6757c4f67c6e885f6a54c5e1a53bd8495a9599be4a')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 csvfab.py -t "$pkgdir/usr/share/csvfab/"
    install -Dm644 server.py viewer.htm papaparse.min.js -t "$pkgdir/usr/share/csvfab/"
    install -Dm644 icons/csvfab.svg -t "$pkgdir/usr/share/csvfab/icons/"
    cp -r ui bridge "$pkgdir/usr/share/csvfab/"
    # /usr/share is not writable at run time: compiled here, or every launch would compile anew.
    python -m compileall -q -d /usr/share/csvfab/bridge "$pkgdir/usr/share/csvfab/bridge"
    install -Dm644 icons/csvfab.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/csvfab.svg"
    for s in 16 24 32 48 64 128 256 512; do
        install -Dm644 "icons/csvfab-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/csvfab.png"
    done
    install -Dm644 csvfab.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/share/csvfab/csvfab.py "$pkgdir/usr/bin/csvfab"   # the launcher follows the link back to its files
}
